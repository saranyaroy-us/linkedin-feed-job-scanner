# Local secrets for `npm run dev` (wrangler dev). Copy to .env and fill in.
# .env is git-ignored. In production these are Cloudflare secrets set with
# `npx wrangler secret put <NAME>` — never put real values in this file.

# Apify API token (Apify Console → Settings → API & Integrations).
APIFY_TOKEN=

# Shared secret Apify sends in the X-Apify-Webhook-Secret header (any long random string).
APIFY_WEBHOOK_SECRET=

# HTTP Basic credentials for the dashboard and /api/posts.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
