{
  "name": "linkedin-job-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud LinkedIn job-signal discovery: Apify harvestapi/linkedin-post-search -> webhook -> Cloudflare Worker -> D1 -> Hono dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --include-env=false",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply linkedin-job-scanner --local",
    "db:migrate:remote": "wrangler d1 migrations apply linkedin-job-scanner --remote"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
